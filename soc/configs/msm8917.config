# Qualcomm MSM8917 / Snapdragon 425.
# Four Cortex-A53 cores; no big.LITTLE cluster. Do not infer core IDs or timer/IRQ/MMIO values here.
CONFIG_SOC="msm8917"
CONFIG_CPUS=4
# BOOTCPU is intentionally not set until the boot CPU/core numbering is verified on the target.
# No SC7280-specific drivers or register defaults are inherited.
